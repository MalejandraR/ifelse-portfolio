---
/**
 * SocialLinks — renders the configured GitHub / LinkedIn / email links, but
 * ONLY when the corresponding value in src/data/site.ts is a valid URL /
 * email (spec §9). When nothing is configured the component renders nothing:
 * no `href="#"`, no fictitious URLs. External profiles open in a new tab.
 */
import { getSocials, type SocialKey } from '../data/site';

interface Props {
  class?: string;
  /** Render icon + visible text label (Contact section) instead of icon-only. */
  labeled?: boolean;
}

const { class: className, labeled = false } = Astro.props;
const links = getSocials();

const icons: Record<SocialKey, { path: string; viewBox: string; fill: boolean }> = {
  github: {
    viewBox: '0 0 16 16',
    fill: true,
    path: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z',
  },
  linkedin: {
    viewBox: '0 0 24 24',
    fill: true,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
  email: {
    viewBox: '0 0 24 24',
    fill: false,
    path: 'M3 6.5h18a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm.6.9 8.4 5.9 8.4-5.9',
  },
};

interface Entry {
  key: SocialKey;
  /** Accessible name (may be richer than the visible label). */
  label: string;
  href: string;
  rel?: string;
  target?: string;
}

const entries: Entry[] = links.map((link) => ({
  key: link.key,
  label: link.label,
  href: link.href,
  rel: link.key === 'email' ? undefined : 'noopener noreferrer',
  target: link.key === 'linkedin' ? '_blank' : undefined,
}));
---

{
  entries.length > 0 && (
    <div class:list={['socials', labeled && 'socials--labeled', className]}>
      {entries.map((entry) => {
        const icon = icons[entry.key];
        return (
          <a href={entry.href} aria-label={entry.label} rel={entry.rel} target={entry.target}>
            <svg
              viewBox={icon.viewBox}
              fill={icon.fill ? 'currentColor' : 'none'}
              stroke={icon.fill ? 'none' : 'currentColor'}
              stroke-width={icon.fill ? undefined : 1.7}
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icon.path} />
            </svg>
            {labeled && <span>{entry.label}</span>}
          </a>
        );
      })}
    </div>
  )
}
