---
/**
 * Hero — eyebrow, monospace subtitle, H1 with lime highlight, description and
 * two CTAs on the left; decorative branching visual on the right (spec §6.2).
 */
import BranchingVisual from './BranchingVisual.astro';
import { site } from '../data/site';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.eyebrow}</p>
        <p class="hero-subtitle">
          <span class="hero-subtitle-primary">{site.subtitle.line1}</span>
          <span class="hero-subtitle-secondary">{site.subtitle.line2}</span>
        </p>
        <h1 class="hero-title" id="hero-title">{site.headline.line1}<br class="hero-break" />{site.headline.line2}<span class="accent">{site.headline.highlight}</span></h1>
        <p class="hero-description">{site.heroDescription}</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#proyectos">Ver proyectos →</a>
          <a class="btn btn--ghost" href="#sobre-mi">Sobre mí</a>
        </div>
      </div>

      <div class="hero-visual">
        <BranchingVisual />
      </div>
    </div>
  </div>
</section>
